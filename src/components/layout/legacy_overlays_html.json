{"html": "<div id=\"authGate\" style=\"display:flex;position:fixed;top:0;left:0;right:0;bottom:0;background:var(--bg-primary, #020617);z-index:9999;align-items:center;justify-content:center;\">\n<!-- 登录页底纹和主界面同源：两团径向渐变，无位图。放在卡片下面一层。 -->\n<div style=\"position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 70% 55% at 50% 0%, rgba(79,70,229,0.18), transparent 65%),radial-gradient(ellipse 60% 50% at 50% 100%, rgba(225,29,72,0.10), transparent 65%);\"></div>\n<div style=\"position:relative;background:var(--glass, rgba(15,23,42,0.8));-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px);border:1px solid var(--border-strong, #334155);border-radius:16px;padding:36px 32px;width:92%;max-width:420px;box-shadow:var(--shadow-2xl, 0 25px 50px -12px rgba(0,0,0,0.25));\">\n<div style=\"text-align:center;margin-bottom:24px;\">\n<!-- 站名走主色渐变裁字：background-clip:text + 透明文字色。\n           不支持时会退化成透明字看不见，所以 color 先给实色兜底，\n           再用 -webkit-text-fill-color 覆盖 —— 只有支持裁字的内核才认这个属性。 -->\n<div style=\"font-size:24px;font-weight:700;color:var(--text-primary, #f8fafc);background:linear-gradient(to right,#818cf8,#c084fc);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;display:inline-block;\">自媒体AI运营平台</div>\n<div id=\"authGateSub\" style=\"font-size:13px;color:var(--text-secondary, #94a3b8);margin-top:6px;\">国内电商 · 自媒体内容运营一体化平台</div>\n</div>\n<!-- Tab -->\n<div style=\"display:flex;border:1px solid var(--border,#1e293b);border-radius:10px;overflow:hidden;margin-bottom:18px;background:var(--bg-primary,#020617);\">\n<button id=\"authTabLogin\" onclick=\"switchAuthTab('login')\" style=\"flex:1;padding:10px;border:none;background:linear-gradient(to right,#4f46e5,#9333ea);color:#fff;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;\">登录</button>\n<button id=\"authTabRegister\" onclick=\"switchAuthTab('register')\" style=\"flex:1;padding:10px;border:none;background:transparent;color:var(--text-secondary);font-size:14px;cursor:pointer;font-family:inherit;\">注册</button>\n</div>\n<!-- Login form -->\n<div id=\"authFormLogin\" style=\"display:block;\">\n<input autocomplete=\"username\" class=\"text-input\" id=\"authUsername\" name=\"username\" placeholder=\"用户名\" style=\"margin-bottom:12px;width:100%;\"/>\n<input autocomplete=\"current-password\" class=\"text-input\" id=\"authPassword\" name=\"password\" onkeydown=\"if(event.key==='Enter')authLogin()\" placeholder=\"密码\" style=\"margin-bottom:18px;width:100%;\" type=\"password\"/>\n<button class=\"btn btn-primary btn-lg\" id=\"authBtnLogin\" onclick=\"authLogin()\" style=\"width:100%;justify-content:center;\">登录</button>\n<div id=\"authError\" style=\"margin-top:10px;font-size:13px;color:#ef4444;text-align:center;display:none;\"></div>\n</div>\n<!-- Register form -->\n<div id=\"authFormRegister\" style=\"display:none;\">\n<input autocomplete=\"username\" class=\"text-input\" id=\"regUsername\" name=\"new-username\" placeholder=\"用户名（字母/数字/下划线，3-20位）\" style=\"margin-bottom:12px;width:100%;\"/>\n<input autocomplete=\"new-password\" class=\"text-input\" id=\"regPassword\" name=\"new-password\" placeholder=\"密码（至少6位）\" style=\"margin-bottom:12px;width:100%;\" type=\"password\"/>\n<input autocomplete=\"new-password\" class=\"text-input\" id=\"regPassword2\" name=\"new-password-confirm\" onkeydown=\"if(event.key==='Enter')authRegister()\" placeholder=\"确认密码\" style=\"margin-bottom:18px;width:100%;\" type=\"password\"/>\n<button class=\"btn btn-primary btn-lg\" id=\"authBtnRegister\" onclick=\"authRegister()\" style=\"width:100%;justify-content:center;\">注册</button>\n<div id=\"authErrorReg\" style=\"margin-top:10px;font-size:13px;color:#ef4444;text-align:center;display:none;\"></div>\n</div>\n<div style=\"margin-top:16px;font-size:11px;color:var(--text-secondary);text-align:center;\">\n<span id=\"authFooterHint\">新用户开放注册 · 密码 PBKDF2 哈希存储</span>\n</div>\n</div>\n</div>\n<div class=\"modal-overlay\" id=\"editorModal\" onclick=\"if(event.target===this)closeEditor()\" style=\"display:none;\">\n<div class=\"modal\">\n<div class=\"modal-header\">\n<div>\n<h3 style=\"font-size:16px;font-weight:600;\">文章编辑器</h3>\n<span id=\"editorPlatformLabel\" style=\"font-size:12px;color:var(--text-secondary);\">面向：微信公众号</span>\n</div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"closeEditor()\">\n<svg fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\"><line x1=\"18\" x2=\"6\" y1=\"6\" y2=\"18\"></line><line x1=\"6\" x2=\"18\" y1=\"6\" y2=\"18\"></line></svg>\n</button>\n</div>\n<div class=\"modal-body\">\n<div class=\"editor-toolbar\">\n<button class=\"editor-tool\" onclick=\"document.execCommand('formatBlock',false,'h2')\" title=\"标题\"><b>H2</b></button>\n<button class=\"editor-tool\" onclick=\"document.execCommand('formatBlock',false,'h3')\" title=\"副标题\"><b>H3</b></button>\n<button class=\"editor-tool\" onclick=\"document.execCommand('bold')\" title=\"加粗\"><b>B</b></button>\n<button class=\"editor-tool\" onclick=\"document.execCommand('italic')\" title=\"斜体\"><i>I</i></button>\n<button class=\"editor-tool\" onclick=\"document.execCommand('underline')\" title=\"下划线\"><u>U</u></button>\n<span style=\"width:1px;height:24px;background:var(--border);margin:0 4px;\"></span>\n<button class=\"editor-tool\" onclick=\"document.execCommand('insertUnorderedList')\" title=\"无序列表\">•</button>\n<button class=\"editor-tool\" onclick=\"document.execCommand('insertOrderedList')\" title=\"有序列表\">1.</button>\n<button class=\"editor-tool\" onclick=\"document.execCommand('formatBlock',false,'blockquote')\" title=\"引用\">\"</button>\n<span style=\"width:1px;height:24px;background:var(--border);margin:0 4px;\"></span>\n<button class=\"editor-tool\" onclick=\"editorApplyRich('key')\" style=\"color:#3b82f6;font-weight:700;\" title=\"标为核心词（蓝）\">A</button>\n<button class=\"editor-tool\" onclick=\"editorApplyRich('num')\" style=\"color:#ea580c;font-weight:700;\" title=\"标为数字/价格（橙）\">A</button>\n<button class=\"editor-tool\" onclick=\"editorApplyRich('good')\" style=\"color:#16a34a;font-weight:700;\" title=\"标为优点（绿）\">A</button>\n<button class=\"editor-tool\" onclick=\"editorApplyRich('warn')\" style=\"color:#e8453c;font-weight:700;\" title=\"标为提醒（红）\">A</button>\n<button class=\"editor-tool\" onclick=\"editorApplyRich('hl')\" style=\"background:#fff3cd;color:#7c2d12;font-weight:700;\" title=\"黄色高亮\">A</button>\n<button class=\"editor-tool\" onclick=\"editorApplyRich('')\" title=\"清除上色\">✕色</button>\n<span style=\"width:1px;height:24px;background:var(--border);margin:0 4px;\"></span>\n<button class=\"editor-tool\" onclick=\"insertImage()\" title=\"插入图片\">IMG</button>\n</div>\n<div class=\"editor-content\" contenteditable=\"true\" id=\"editorContent\"></div>\n</div>\n<div class=\"modal-footer\">\n<button class=\"btn btn-save\" onclick=\"saveArticleFull()\">\n<svg fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"></path><polyline points=\"17,21 17,13 7,13 7,21\"></polyline><polyline points=\"7,3 7,8 15,8\"></polyline></svg>\n        保存全文\n      </button>\n<button class=\"btn btn-outline\" onclick=\"copyArticleHtml()\">\n<svg fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\"><rect height=\"13\" rx=\"2\" width=\"13\" x=\"9\" y=\"9\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path></svg>\n        复制全文\n      </button>\n<button class=\"btn btn-outline\" onclick=\"exportArticle()\">\n<svg fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"7,10 12,15 17,10\"></polyline><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"></line></svg>\n        导出文件\n      </button>\n<button class=\"btn btn-primary\" onclick=\"publishArticle()\">\n<svg fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\"><line x1=\"12\" x2=\"12\" y1=\"5\" y2=\"19\"></line><polyline points=\"19,12 12,19 5,12\"></polyline></svg>\n        跳转平台后台发布\n      </button>\n</div>\n</div>\n</div>\n<div class=\"modal-overlay\" id=\"bindModal\" onclick=\"if(event.target===this)closeBindModal()\" style=\"display:none;\">\n<div class=\"modal\" style=\"max-width:560px;\">\n<div class=\"modal-header\">\n<div>\n<h3 data-i18n=\"modal.bind.title\" id=\"bindModalTitle\" style=\"font-size:16px;font-weight:600;\">添加账号</h3>\n<span data-i18n=\"modal.bind.sub\" id=\"bindModalSub\" style=\"font-size:12px;color:var(--text-secondary);\">选择平台并完成授权绑定</span>\n</div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"closeBindModal()\">\n<svg fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\"><line x1=\"18\" x2=\"6\" y1=\"6\" y2=\"18\"></line><line x1=\"6\" x2=\"18\" y1=\"6\" y2=\"18\"></line></svg>\n</button>\n</div>\n<div class=\"modal-body\">\n<!-- Step indicators -->\n<div class=\"bind-steps\" id=\"bindSteps\">\n<div class=\"bind-step active\" id=\"bs1\"><span class=\"bind-step-num\">1</span><span data-i18n=\"modal.bind.step1\">选择平台</span></div>\n<div class=\"bind-step\" id=\"bs3\"><span class=\"bind-step-num\">2</span><span data-i18n=\"modal.bind.step2\">授权绑定</span></div>\n</div>\n<!-- Step 1: Choose platform -->\n<div id=\"bindStep1\">\n<div class=\"platform-select-grid\">\n<!-- data-plat 的值必须和 platformAccountStore / platformColors /\n               platformIcons 三个字典的键完全一致，改名要四处同改 -->\n<div class=\"platform-option\" data-plat=\"douyin\" onclick=\"selectBindPlatform('douyin', this)\">\n<div class=\"plat-icon\" style=\"color:#FE2C55;\">🎵</div><div style=\"font-weight:600;font-size:14px;\">抖音</div><div class=\"plat-label\">短视频 &amp; 直播带货</div>\n</div>\n<div class=\"platform-option\" data-plat=\"xiaohongshu\" onclick=\"selectBindPlatform('xiaohongshu', this)\">\n<div class=\"plat-icon\" style=\"color:#FF2442;\">📕</div><div style=\"font-weight:600;font-size:14px;\">小红书</div><div class=\"plat-label\">图文笔记 &amp; 种草</div>\n</div>\n<div class=\"platform-option\" data-plat=\"kuaishou\" onclick=\"selectBindPlatform('kuaishou', this)\">\n<div class=\"plat-icon\" style=\"color:#FF6E00;\">⚡</div><div style=\"font-weight:600;font-size:14px;\">快手</div><div class=\"plat-label\">短视频 &amp; 老铁私域</div>\n</div>\n<div class=\"platform-option\" data-plat=\"shipinhao\" onclick=\"selectBindPlatform('shipinhao', this)\">\n<div class=\"plat-icon\" style=\"color:#07C160;\">🎬</div><div style=\"font-weight:600;font-size:14px;\">微信视频号</div><div class=\"plat-label\">微信生态 &amp; 私域转化</div>\n</div>\n<div class=\"platform-option\" data-plat=\"gongzhonghao\" onclick=\"selectBindPlatform('gongzhonghao', this)\">\n<div class=\"plat-icon\" style=\"color:#576B95;\">💬</div><div style=\"font-weight:600;font-size:14px;\">微信公众号</div><div class=\"plat-label\">长文 &amp; 品牌沉淀</div>\n</div>\n<div class=\"platform-option\" data-plat=\"toutiao\" onclick=\"selectBindPlatform('toutiao', this)\">\n<div class=\"plat-icon\" style=\"color:#F04142;\">📰</div><div style=\"font-weight:600;font-size:14px;\">今日头条</div><div class=\"plat-label\">资讯分发 &amp; 搜索流量</div>\n</div>\n<div class=\"platform-option\" data-plat=\"bilibili\" onclick=\"selectBindPlatform('bilibili', this)\">\n<div class=\"plat-icon\" style=\"color:#FB7299;\">📺</div><div style=\"font-weight:600;font-size:14px;\">B站</div><div class=\"plat-label\">中长视频 &amp; Z世代</div>\n</div>\n</div>\n<button class=\"btn btn-primary\" data-i18n=\"modal.bind.continue\" disabled=\"\" id=\"btnBindNext1\" onclick=\"goBindStep3()\" style=\"width:100%;margin-top:16px;justify-content:center;\">下一步 → 授权绑定</button>\n</div>\n<!-- Step 2: Mock OAuth (demo binding) -->\n<div id=\"bindStep3\" style=\"display:none;text-align:center;\">\n<div class=\"qr-display\" id=\"qrContainer\" style=\"width:200px;height:200px;margin:0 auto 16px;padding:8px;background:#fff;border-radius:16px;display:flex;align-items:center;justify-content:center;\">\n<svg fill=\"none\" height=\"60\" stroke=\"#6366f1\" stroke-width=\"1.5\" style=\"opacity:0.3;\" viewbox=\"0 0 24 24\" width=\"60\">\n<rect height=\"18\" rx=\"3\" width=\"18\" x=\"3\" y=\"3\"></rect><rect height=\"8\" rx=\"1\" width=\"8\" x=\"8\" y=\"8\"></rect>\n<line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"16\"></line><line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"></line>\n</svg>\n</div>\n<p class=\"qr-hint\" data-i18n=\"modal.bind.oauth_hint\" id=\"qrPlatformLabel\">Simulated OAuth 2.0 authorization — this is a demo mock, no real account is bound.</p>\n<p class=\"qr-hint\" style=\"color:var(--text-secondary);\">\n<span data-i18n=\"modal.bind.auto_bind_as\">If OAuth cannot complete, will auto-mock-bind as</span> <span id=\"qrAutoName\" style=\"color:var(--accent-light);font-weight:600;\"></span>\n</p>\n<div id=\"qrCountdown\" style=\"margin-top:12px;font-size:24px;font-weight:700;color:var(--accent-light);\"></div>\n<div style=\"display:flex;gap:8px;margin-top:16px;\">\n<button class=\"btn btn-outline\" data-i18n=\"modal.bind.back\" onclick=\"goBindStep1()\" style=\"flex:1;justify-content:center;\">上一步</button>\n<button class=\"btn btn-primary\" id=\"btnBindComplete\" onclick=\"completeBind()\" style=\"flex:1;justify-content:center;\">完成模拟绑定</button>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"modal-overlay\" id=\"dashboardModal\" onclick=\"if(event.target===this)closeDashboard()\" style=\"display:none;\">\n<div class=\"modal\" style=\"max-width:720px;\">\n<div class=\"modal-header\">\n<div style=\"display:flex;align-items:center;gap:12px;\">\n<div class=\"acct-avatar\" id=\"dashAvatar\" style=\"width:40px;height:40px;font-size:16px;\">A</div>\n<div>\n<h3 id=\"dashName\" style=\"font-size:16px;font-weight:600;\">账号名称</h3>\n<span id=\"dashPlatform\" style=\"font-size:12px;color:var(--text-secondary);\">平台</span>\n</div>\n</div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"closeDashboard()\">\n<svg fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\"><line x1=\"18\" x2=\"6\" y1=\"6\" y2=\"18\"></line><line x1=\"6\" x2=\"18\" y1=\"6\" y2=\"18\"></line></svg>\n</button>\n</div>\n<div class=\"modal-body\">\n<div class=\"dashboard-stats\">\n<div class=\"dash-stat-card\">\n<div class=\"dash-val\" id=\"dashLikes\" style=\"color:#6366f1;\">0</div>\n<div class=\"dash-lbl\">👍 点赞</div>\n<div class=\"dash-sub dash-growth\" id=\"dashLikesGrowth\"></div>\n</div>\n<div class=\"dash-stat-card\">\n<div class=\"dash-val\" id=\"dashComments\" style=\"color:#22c55e;\">0</div>\n<div class=\"dash-lbl\">💬 评论</div>\n<div class=\"dash-sub dash-growth\" id=\"dashCommentsGrowth\"></div>\n</div>\n<div class=\"dash-stat-card\">\n<div class=\"dash-val\" id=\"dashShares\" style=\"color:#f97316;\">0</div>\n<div class=\"dash-lbl\">🔄 转发</div>\n<div class=\"dash-sub dash-growth\" id=\"dashSharesGrowth\"></div>\n</div>\n<div class=\"dash-stat-card\">\n<div class=\"dash-val\" id=\"dashViews\" style=\"color:#eab308;\">0</div>\n<div class=\"dash-lbl\" id=\"dashViewsLabel\">👁 播放/阅读</div>\n<div class=\"dash-sub dash-growth\" id=\"dashViewsGrowth\"></div>\n</div>\n<div class=\"dash-stat-card\">\n<div class=\"dash-val\" id=\"dashWorks\" style=\"color:#06b6d4;\">0</div>\n<div class=\"dash-lbl\">📂 作品数</div>\n</div>\n</div>\n<div style=\"font-size:14px;font-weight:600;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;\">\n<span>📝 最新评论</span>\n<span id=\"dashCommentCount\" style=\"font-size:12px;color:var(--text-secondary);font-weight:400;\">0 条评论</span>\n</div>\n<div class=\"comment-list\" id=\"commentList\"></div>\n</div>\n</div>\n</div>\n<div id=\"toastContainer\"></div>"}