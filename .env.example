# 自媒体AI运营平台 配置模板 —— 复制为 .env 后填入真实值（.env 本身不入库）
# 由 server.py 启动时 _load_dotenv() 读取。已在 .gitignore 中，HTTP 层也拿不到。
# 服务器部署请改用 systemd EnvironmentFile（/etc/globalsales.env，chmod 600），
# 真实环境变量优先级高于本文件。

# ---- 厂商 API 密钥 ----
MM_API_KEY=在此填入你自己的 MM_API_KEY
HY_API_KEY=在此填入你自己的 HY_API_KEY
AGNES_API_KEY=在此填入你自己的 AGNES_API_KEY
ARK_API_KEY=在此填入你自己的 ARK_API_KEY
# 火山方舟 Agent Plan 专属 Key（端点 api/plan/v3，模型 ark-code-latest）。
# 与上面的 ARK_API_KEY 是**两把不同的 key**，不可互换：
#   ARK_API_KEY      → api/v3/images/generations（Seedream 出图）
#   ARK_PLAN_API_KEY → api/plan/v3/chat/completions（文本 + 图片理解）
# 互换会分别拿到 404 UnsupportedModel / 401 AuthenticationError。
ARK_PLAN_API_KEY=在此填入你自己的 ARK_PLAN_API_KEY
SEEDANCE_MINI_API_KEY=在此填入你自己的 SEEDANCE_MINI_API_KEY

# ---- 首次建库时的管理员账号（库已存在则不生效）----
GS_ADMIN_USER=admin
GS_ADMIN_PASS=change-me-before-first-run

# ---- 服务配置 ----
GS_PORT=8766
# 套了 HTTPS 反代后设为 1，让会话 cookie 带 Secure 标记
GS_COOKIE_SECURE=0
